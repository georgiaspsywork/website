---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Photo from '../components/Photo.astro';
import headshot from '../assets/images/georgia-red-dress-brick-window.webp';

const services = [
  {
    id: 'diagnostic',
    title: 'Fatigue Risk Diagnostic',
    audience: "For organisations that suspect fatigue is a problem but don't know exactly where or why.",
    what: 'A structured assessment of fatigue risk across your operation.',
    listLabel: 'Includes',
    list: [
      'Workforce fatigue survey',
      'Stakeholder interviews and focus groups',
      'Working-pattern review',
      'Incident, absence and overtime data review',
      'Assessment against my 8-factor fatigue model',
      'Risk hotspots and prioritised recommendations',
    ],
  },
  {
    id: 'audit',
    title: 'Fatigue & Human Factors Audit',
    audience: 'For organisations wanting a deeper assessment of how fatigue is being controlled.',
    what: 'I review the system, looking at rota design, actual hours, overtime, on-call activity, recovery, workload, staffing, handovers, reporting, escalation, culture, incident investigation and management.',
    listLabel: 'Output',
    list: ['RAG-rated audit', 'Risk register', 'Control gaps', 'Improvement roadmap'],
  },
  {
    id: 'review',
    title: 'Shift, Rota & On-Call Review',
    audience: 'What does the rota say, and what are people actually working?',
    what: 'I review planned versus real working patterns, then provide practical options for redesign. Particularly valuable in service operations.',
    listLabel: 'I look at',
    list: [
      'Scheduled hours and night work',
      'Consecutive duties and overtime',
      'Call-outs and sleep disruption',
      'Short recovery periods and shift swaps',
      'Travel and commuting considerations',
      'Workload after disrupted nights',
    ],
  },
  {
    id: 'training',
    title: 'Fatigue & Manager Training',
    audience: 'Managing Fatigue in Operational Teams',
    what: 'Managers learn how to identify fatigue risk, have fatigue conversations, assess immediate operational risk, respond after disrupted on-call nights, escalate concerns, understand their responsibilities and distinguish individual tiredness from systemic fatigue risk.',
    listLabel: 'Three levels',
    list: ['Frontline awareness', 'Manager capability', 'Senior leader masterclass'],
  },
  {
    id: 'ai-workshop',
    title: 'The Human Behind the AI',
    audience: 'A workshop for organisations introducing AI into shift-based teams.',
    what: [
      'AI can make tasks quicker, but what happens to the person doing the work?',
      'This interactive workshop explores how AI changes the jobs, decisions and demands around it. Participants will consider what AI removes from work, what it adds, and what people may be left to manage: checking outputs, monitoring systems, learning new processes, making difficult decisions and carrying accountability.',
      'Using practical examples and discussion, we’ll explore cognitive demand, fatigue, automation bias and what people need to exercise meaningful judgement and oversight. Participants will leave with my Human Impact Check, a practical framework for examining demand, control, clarity, capability, capacity, accountability, security and recovery, plus questions to bring into AI planning and change conversations.',
      'The focus is on understanding the work people will experience and designing AI-enabled change with that human impact in view.',
    ],
    listLabel: "My Human Impact Check looks at",
    list: ['Demand', 'Control', 'Clarity', 'Capability', 'Capacity', 'Accountability', 'Security', 'Recovery'],
    link: { label: 'Further reading: AI agents push humans out of the loop', href: '/sources#mitchell2026', note: "Mitchell, Ghosh & Passi (2026) argue that keeping a human in the loop doesn't guarantee effective oversight, and that extended AI use can erode the very skills people need to oversee it." },
  },
  {
    id: 'change-fatigue',
    title: 'Change Fatigue',
    audience: 'A training session or workplace assessment.',
    what: [
      'Change can ask a lot of people, especially when new priorities, systems or ways of working keep arriving before they have had time to adjust.',
      'This interactive workshop explores how ongoing change can affect people’s workload, attention, confidence and capacity. We’ll look at what may sit behind behaviours sometimes labelled as “resistance”, and consider how uncertainty, competing demands and limited recovery can shape people’s experience of change.',
      'Through practical examples and discussion, participants will reflect on what change is asking of their teams, where pressure is building and how the working environment could better support people through it. They’ll leave with useful questions to bring into change conversations and planning.',
      'The focus is on understanding the human impact of change and making the work around it more manageable.',
    ],
    listLabel: 'Includes',
    list: [],
  },
];
---

<BaseLayout
  title="Fatigue and human factors services · Georgia's PsyWork"
  description="Fatigue risk diagnostics, human factors audits, shift and on-call reviews and manager training for shift, on-call and high-demand operations."
>
  <PageHero
    eyebrow="Services"
    title="Fatigue &amp; human {{<em>factors.</em>}}"
    intro="Reduce the cost of fatigue. I help organisations with shift, on-call and high-demand workers identify where fatigue is increasing the risk of incidents, errors, absence and turnover, and redesign the conditions creating it."
  >
    <div class="flex flex-wrap items-center gap-x-6 gap-y-4 pt-2">
      <Button href="/contact" variant="brand">Get in touch</Button>
      <Button href="#services" variant="outline">See the six services</Button>
      <Button href="/fatigue-model" variant="underline">My 8-factor fatigue model</Button>
    </div>
  </PageHero>

  {/* Services */}
  <Section id="services" tone="deep" class="flex scroll-mt-12 flex-col gap-14">
    <SectionHeader eyebrow="How I can help" title="Six ways to work together" tone="amber" />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        services.map((s, i) => (
          <article id={s.id} class={`flex flex-col gap-6 rounded-sm border border-line-soft bg-surface p-[clamp(24px,3.5vw,40px)]${i === services.length - 1 && services.length % 2 === 1 ? ' md:col-span-2' : ''}`}>
            <div class="flex flex-col gap-3">
              <Eyebrow tone="amber">{String(i + 1).padStart(2, '0')}</Eyebrow>
              <h3 class="text-title leading-title tracking-heading text-ink-bright">{s.title}</h3>
              <p class="text-xl leading-body text-mint italic text-pretty">{s.audience}</p>
            </div>
            <div class="flex flex-col gap-4">{(Array.isArray(s.what) ? s.what : [s.what]).map((para) => <p class="text-lg leading-prose text-pretty text-muted">{para}</p>)}</div>
            {s.list.length > 0 && (
            <div class="flex flex-col gap-3">
              <Eyebrow tone="soft" size="xs">{s.listLabel}</Eyebrow>
              <ul class="flex list-none flex-col border-b border-line *:border-t *:border-line">
                {s.list.map((item) => <li class="py-2.5 text-lg text-ink-soft">{item}</li>)}
              </ul>
            </div>
            )}
            {s.link && <p class="text-lg leading-prose text-pretty text-muted">{s.link.note}</p>}
            {s.link && <Button href={s.link.href} variant="underline">{s.link.label}</Button>}
          </article>
        ))
      }
    </div>
  </Section>

  {/* Closing call to action */}
  <Section class="md:px-0">
   <div class="mx-auto grid items-center gap-x-10 gap-y-10 md:w-4/5 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
    <div class="flex flex-col items-start gap-7">
      <h2 class="max-w-[14em] text-display leading-display tracking-display text-balance">Not sure where to start? <em>Let&rsquo;s talk it through.</em></h2>
      <p class="max-w-[34em] text-xl leading-prose text-pretty text-muted">
        Get in touch for a conversation about what you are seeing in your operation. I can recommend the right starting point.
      </p>
      <Button href="/contact" variant="brand">Get in touch</Button>
    </div>
    <Photo src={headshot} alt="Georgia Hodkinson, smiling, in a red polo-neck dress, leaning on the back of a blue armchair in a sunlit room with a brick wall behind her" ratio="4/5" sizes="(min-width: 768px) 300px, 70vw" class="max-w-[300px] md:max-w-none" />
   </div>
  </Section>
</BaseLayout>
