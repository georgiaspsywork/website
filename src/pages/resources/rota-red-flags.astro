---
import { site } from '../../data/site';
import { getEntry } from 'astro:content';
import ResourceLayout from '../../layouts/ResourceLayout.astro';
import Checklist from '../../components/Checklist.astro';

// Bespoke resource page: the standard resource layout with the twelve-question tick-list as its centrepiece.
// The words around it come from src/content/resources/rota-red-flags.md. Sources are on the Sources page.
const resource = (await getEntry('resources', 'rota-red-flags'))!;

const items = [
  {
    title: 'Do people work more than three nights in a row?',
    body: 'Injury risk was about 36% higher by the fourth night in a block than on the first (Fischer et al., 2017). Next: look at shortening the longest blocks of nights.',
  },
  {
    title: 'Is there ever less than 11 hours between the end of one shift and the start of the next?',
    body: 'A trial that halved short daily rest periods (under 11 hours between shifts) led to a smaller rise in sickness absence days (Djupedal et al., 2025). Next: list every quick return in the four weeks and who it affects.',
  },
  {
    title: 'Do people come off nights straight into a day or evening shift?',
    body: 'In interviews with night-shift workers, recovery time after nights was often not built into rosters and ate into days off (Moore & Ballardie, 2024). Next: check what the first day after a run of nights actually looks like.',
  },
  {
    title: 'Does the pattern rotate backwards, for example late shifts into early shifts?',
    body: 'Our rota builder flags backward rotation. Next: check which direction each crew moves through the pattern, and ask the crews how it feels.',
  },
  {
    title: 'Does anyone work more than five days without a rest day, or very long weeks?',
    body: 'Working 55 hours or more a week was linked to an estimated 745,194 deaths from heart disease and stroke worldwide in 2016 (Pega et al., 2021). Next: count the longest run of working days and the longest week for each person, including overtime.',
  },
  {
    title: 'Are any shifts longer than 12 hours?',
    body: 'Injury risk was higher on shifts longer than 12 hours (relative risk 1.34) (Fischer et al., 2017). Working more than 12 hours a day was also linked to more safety incidents, though the certainty of that evidence was low (Matre et al., 2021). Next: note which roles and which times of day the long shifts fall on.',
  },
  {
    title: 'Do breaks come less often than every four hours, or last under 30 minutes?',
    body: 'Injury risk was highest when rest breaks came less often than every four hours or lasted under 30 minutes (Fischer et al., 2017). Next: check the breaks people actually take, not just the ones on paper.',
  },
  {
    title: 'Is overtime or shift-swapping frequent, or always the same people?',
    body: 'HSE says problems with overtime and shift-swapping may point to inadequate resourcing and staffing levels (HSE, n.d.). Next: list who picked up the extra shifts over the last month.',
  },
  {
    title: 'Do your most demanding or safety-critical tasks fall between 02:00 and 06:00?',
    body: 'In shift workers, accuracy at 03:00 fell most on the hardest version of a task (Galy et al., 2008). HSE says people tire more easily when work is machine-paced, complex or monotonous (HSE, n.d.). Next: map the highest-risk tasks against the clock, and move or double-check what you can.',
  },
  {
    title: 'Do handovers happen at the end of long shifts, or in a rush or a noisy room?',
    body: 'In critical care nurses, time stress and fatigue were linked to poorer handover quality, and standardised handover tools were named as a help (Abou Hashish et al., 2023). Next: watch one handover at the end of a shift.',
  },
  {
    title: 'Do people drive home after night shifts?',
    body: 'Night-shift workers reported driving home, some for over two hours, and traffic accidents or near misses (Moore & Ballardie, 2024). Next: ask people how they get home, and what happens on the drive.',
  },
  {
    title: 'Have the people who work this rota been asked how it affects them?',
    body: 'HSE recommends consulting employees on working hours and shift patterns (HSE, n.d.). Next: put the same questions to the people on every shift, not just those at head office.',
  },
];

const verdicts = [
  'Nothing ticked yet. Tick each question that is true of your rota.',
  'One flag. Worth a look, but not yet a pattern.',
  'Two flags. Worth a look, but not yet a pattern.',
  ...Array.from({ length: 10 }, (_, i) =>
    i + 3 === 3 ? 'Three flags. A pattern worth looking at with the people who work it.' : `${i + 3} flags. A pattern worth looking at with the people who work it.`,
  ),
];
---

<ResourceLayout resource={resource}>
  <Fragment slot="tool">
    <Checklist eyebrow="Twelve questions" title="Tick every one that is true of your rota" items={items} verdicts={verdicts} cta={{ label: 'Talk it through with Georgia', href: site.calendly }} />
    <p class="px-gutter py-6 text-xs text-faint">Full references are on the <a class="text-mint" href="/sources">Sources page</a>. Rules are simplified for illustration; this is the first ten minutes of a fatigue review, not the whole of one.</p>
  </Fragment>
</ResourceLayout>
