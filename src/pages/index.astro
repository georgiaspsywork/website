---
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import Checklist from '../components/Checklist.astro';
import HoursAwake from '../components/HoursAwake.astro';
import FatigueDrivers from '../components/FatigueDrivers.astro';
import PencilCircle from '../components/PencilCircle.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StepGrid from '../components/StepGrid.astro';
import Step from '../components/Step.astro';
import MarginSection from '../components/MarginSection.astro';
import Photo from '../components/Photo.astro';
import headshot from '../assets/images/georgia-headshot.webp';
import portrait from '../assets/images/georgia-workshop-portrait.webp';

const checklist = [
  { title: 'Incidents cluster at the same points in the rota', body: 'Late in a night run, the third early in a row, the first shift after a changeover. Everyone has noticed. Nobody has joined it up.' },
  { title: "Good people leave shift roles and exit interviews don't say why", body: "Pay is fair and the managers are decent. The turnover keeps coming anyway, and recruitment can't keep up." },
  { title: "Sickness absence is rising and the wellbeing offer hasn't moved it", body: 'The EAP, the app, the awareness week. The number on the dashboard looks the same.' },
  { title: 'Fatigue is managed through hours limits alone', body: 'The rota is compliant. That tells you nothing about how alert people are at 04:00.' },
  { title: 'Rota changes are made for cover, not for recovery', body: "Gaps get filled by whoever will take the extra shift, and it's usually the same few people." },
  { title: 'New systems or AI arrived and nobody checked the workload', body: "It was meant to make the job easier. On a tired night shift, it's one more thing to watch." },
];
const verdicts = [
  'Tick whichever ones land. Nothing here is recorded.',
  'One is common in any shift operation. Worth keeping an eye on.',
  'Two usually share a cause in how the work is designed.',
  'Three is a pattern, not bad luck. A conversation would help name it.',
  "That's a fatigue risk worth looking at properly. It is fixable.",
  "That's a fatigue risk worth looking at properly. It is fixable.",
  'All six. None of it is unusual, and none of it is down to your people.',
];
---
<BaseLayout title="Georgia's PsyWork">
{/* Hero */}
<Section size="none" gutter="reading" class="flex flex-col gap-10 pt-[clamp(80px,12vw,160px)] pb-[clamp(96px,13vw,176px)]">
  <div class="flex flex-col gap-6">
    <h1 class="max-w-[11em] font-normal text-display-xl text-balance leading-none tracking-display">Rested people make <em>safer</em> <PencilCircle>decisions</PencilCircle>.</h1>
    <p class="max-w-[24em] italic text-lead-xl text-mint text-pretty leading-quote">Fatigue doesn't show on the rota. It shows in the incident log.</p>
  </div>
  <Button href="#georgia" variant="brand" class="self-start">About Georgia</Button>
</Section>
{/* Checklist */}
<Checklist
  eyebrow="02:00 · the circadian low"
  title="Which of these sound like your operation?"
  items={checklist}
  verdicts={verdicts}
  cta={{ label: 'Talk it through with Georgia', href: site.calendly }}
/>
{/* Hours awake */}
<HoursAwake />
{/* What drives fatigue */}
<FatigueDrivers />
{/* What the research says */}
<Section tone="deep" class="flex flex-col gap-14">
  <SectionHeader eyebrow="05:00 · what the research says" title="What the evidence says about shift timing and length" tone="amber">
    <p class="text-xl leading-body text-ink-soft text-pretty">
      Findings from systematic reviews and meta-analyses, with their limits. Full references are on the <a class="border-b border-mint text-mint" href="/sources">Sources page</a>.
    </p>
  </SectionHeader>
  <StepGrid>
    <Step stamp="+36%" title="Night shifts">Injury risk on night shifts compared with morning shifts (Fischer et al., 2017).</Step>
    <Step stamp="+34%" title="Shifts over 12 hours">Relative risk of injury on shifts longer than 12 hours was 1.34 (Fischer et al., 2017).</Step>
    <Step stamp="+24%" title="More than 12 hours a day">Higher risk of safety incidents, though the certainty of the evidence was rated low (Matre et al., 2021).</Step>
    <Step stamp="8 v 12" title="No clear winner">Comparisons of 8-hour and 12-hour shifts showed no clear advantage either way, and the evidence quality was low (Patterson et al., 2018).</Step>
  </StepGrid>
</Section>
{/* Three pressures */}
{/* Three pressures */}
<Section size="none" class="flex flex-col gap-14 pt-section-sm pb-section">
  <SectionHeader eyebrow="04:00 · what sits underneath" title="Three pressures, one cost">
    <p class="text-ink-soft text-xl text-pretty leading-body">Fatigue Management, Change Management and AI Transformation are three interconnected pressures reshaping how people experience work and why they leave.</p>
  </SectionHeader>
  <StepGrid>
    <Step variant="number" stamp="01" title="Fatigue">Shift length, rotation and recovery time, and what they do to attention and judgement on the floor.</Step>
    <Step variant="number" stamp="02" title="Change">New systems, new rotas and restructures land on people who are already tired. How it's done decides who stays.</Step>
    <Step variant="number" stamp="03" title="AI">Automation shifts workload and decision-making. We look at where it helps tired teams, and where it quietly adds risk.</Step>
  </StepGrid>
</Section>
{/* Georgia */}
{/* Georgia */}
<Section id="georgia" size="none" class="grid scroll-mt-12 items-center gap-x-18 gap-y-12 pb-section md:grid-cols-2">
  <Photo src={portrait} alt="Georgia standing on a stage in front of a projected 'Workshop activity' slide, holding a clipboard and smiling as she talks to the room" ratio="4/5" class="max-w-[380px]" />
  <div class="flex flex-col gap-5.5">
    <Eyebrow>06:00 · handover</Eyebrow>
    <h2 class="text-title leading-title tracking-heading">Georgia Hodkinson GMBPsS</h2>
    <p class="max-w-[36em] text-ink-soft text-xl text-pretty leading-prose">By combining occupational psychology and systems thinking, we uncover the conditions affecting performance, retention, sickness absence, and risk, then help redesign work so people and organisations can perform sustainably.</p>
    <div class="flex flex-wrap gap-x-6 gap-y-4 text-lg">
      <a class="border-b border-mint text-mint" href="/about#client-feedback">Read client feedback</a>
      <a class="border-b border-brand-edge" href="/about#ethics">Ethics &amp; qualifications</a>
    </div>
  </div>
</Section>
{/* Closing statement */}
<Section tone="deep" class="flex flex-col gap-8">
  <Eyebrow tone="soft">For operations leaders running shift work</Eyebrow>
  <h2 class="max-w-[14em] text-display leading-display tracking-display text-balance">
    Work designed so people stay safe, stay well and <em class="font-normal text-amber">stay.</em>
  </h2>
  <div class="flex flex-wrap items-center gap-4">
    <Button href={site.calendly} target="_blank" variant="brand" class="flex-none text-warm hover:text-warm">Book a 30-minute chat</Button>
    <span class="text-md text-soft">We help organisations in logistics, utilities, energy, emergency services and healthcare reduce fatigue-related incidents and staff turnover.</span>
  </div>
</Section>
{/* Note from Georgia */}
{/* Note from Georgia */}
<MarginSection label="A note from Georgia" class="text-prose">
  <Photo slot="aside" src={headshot} alt="Head-and-shoulders photo of Georgia, smiling, in a white shirt" ratio="4/5" sizes="200px" class="max-w-[200px]" />
  <div class="flex flex-col gap-5.5 text-ink-soft text-2xl leading-loose">
    <p class="text-lead-xl leading-quote text-ink italic text-pretty">&ldquo;I kept meeting capable people who were being blamed for mistakes the design of their work made almost inevitable.&rdquo;</p>
    <p>We help organisations reduce staff turnover and sickness absence by fixing the work conditions that drive burnout, fatigue, and misuse of AI.</p>
    <div class="flex flex-col gap-1.5">
      <p class="italic text-4xl text-prose">Georgia Hodkinson GMBPsS</p>
      <p class="text-lg leading-body text-soft">Organisational psychologist with nine years&rsquo; experience, working with shift workers and high-risk sectors across the UK, including logistics, energy, emergency services and healthcare. MSc Occupational Psychology; Graduate Member of the British Psychological Society.</p>
    </div>
  </div>
</MarginSection>
</BaseLayout>
