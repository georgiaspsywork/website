---
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Step from '../components/Step.astro';
import StepGrid from '../components/StepGrid.astro';

const calendly = site.calendly;

const bookings = [
  {
    featured: true,
    tag: 'Most popular',
    meta: '30 min · video call',
    title: 'Introductory chat',
    body: "A first conversation about your operation, what's prompting the question, and whether a fatigue review is the right next step.",
    href: calendly,
  },
];

const steps = [
  { stamp: 'Day 1', title: 'The conversation', body: "Thirty minutes on what you're seeing and what you've already tried." },
  { stamp: 'Day 3', title: 'A short proposal', body: 'A one-page outline of scope, time and cost. No surprises later.' },
  { stamp: 'Week 2', title: 'On shift', body: 'Time on site, across shifts, alongside your incident and absence data.' },
  { stamp: 'Week 6', title: 'First findings', body: "What's driving fatigue and turnover, what it costs, and where to start." },
];
---

<BaseLayout title="Contact · Georgia's PsyWork" footer={{ ctaHref: calendly }}>
  {/* Contact hero, with the booking card to its right */}
  <section class="grid items-center gap-x-16 gap-y-10 px-gutter-reading pt-section-sm pb-section lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)]">
    <div class="flex flex-col gap-6.5">
      <Eyebrow>Contact · any hour that suits your rota</Eyebrow>
      <h1 class="max-w-[13em] text-display leading-display font-normal tracking-display text-balance">
        Start with a <em>30-minute</em> conversation.
      </h1>
      <p class="max-w-[32em] text-lead leading-snug text-muted text-pretty">
        No pitch and no obligation. Tell us what you're seeing across your shifts, and we'll tell you honestly whether we can help.
      </p>
    </div>
    {
      bookings.map((b) => (
        <a
          href={b.href}
          rel="noopener"
          target="_blank"
          class="flex flex-col gap-4.5 rounded-sm bg-brand p-[clamp(28px,3.5vw,40px)] text-white hover:bg-brand-lift hover:text-white"
        >
          <div class="flex justify-between gap-4 text-xs tracking-label uppercase">
            <span class="text-amber">{b.tag}</span>
            <span class="text-on-brand-muted">{b.meta}</span>
          </div>
          <h2 class="text-lead-xl leading-title tracking-heading">{b.title}</h2>
          <p class="text-lg leading-body text-pretty text-on-brand">{b.body}</p>
          <span class="mt-auto self-start rounded-xs bg-amber px-6 py-3.5 text-md font-semibold text-ground">Book on Calendly ↗</span>
        </a>
      ))
    }
  </section>

  {/* Message form */}
  <ContactForm />

  {/* What happens next */}
  <Section class="flex flex-col gap-12">
    <SectionHeader eyebrow="What happens next" tone="amber" size="md" title="From first call to first finding" />
    <StepGrid>
      {steps.map((s) => <Step stamp={s.stamp} title={s.title}>{s.body}</Step>)}
    </StepGrid>
  </Section>
</BaseLayout>
