---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Eyebrow from '../components/Eyebrow.astro';
import MarginSection from '../components/MarginSection.astro';
import RuledList from '../components/RuledList.astro';
import RuledRow from '../components/RuledRow.astro';
import StepGrid from '../components/StepGrid.astro';
import Step from '../components/Step.astro';
import Button from '../components/Button.astro';
import Photo from '../components/Photo.astro';
import listening from '../assets/images/georgia-listening.webp';
import speaking from '../assets/images/georgia-speaking.webp';

// Recommendations received on LinkedIn, quoted word for word (long ones trimmed to complete sentences).
const recommendations = [
  { quote: 'Georgia is the complete package and I have no hesitation whatsoever in recommending her. Her professional skills are excellent; as an Organisational psychologist, she has a really good breadth and depth of knowledge and expertise.', name: 'Ian B Pettigrew', role: 'Keynote speaker on Hope, bestselling author and leadership development consultant' },
  { quote: 'Georgia rigorously evaluated BAT against leading organisational psychology frameworks, including psychological safety, organisational trust, self-determination theory, and the Job Demands-Resources model.', name: 'Debra Corey', role: 'Step It Up HR, on reviewing their Behaviour Awareness Tool (BAT)' },
  { quote: 'Fully recommend working with Georgia; she has helped bring clarity into our world of chaos.', name: 'James Green', role: 'Founding Director, Football Studies Limited' },
  { quote: 'Georgia is a passionate and highly knowledgeable psychologist with particular expertise in burnout, emotional wellbeing, and workplace mental health. She combines professional insight with empathy, creating a supportive environment in which people feel genuinely heard and understood.', name: 'Aland Yarden Escudero', role: 'Manufacturing Engineer and Higher Education Lecturer' },
  { quote: 'Georgia’s ability to shape complex fatigue information into something practical and engaging made the session both seamless and energising. Her approach is grounded, evidence-based and fully collaborative, which is a rare combination that leaves a lasting impact.', name: 'Dr Jill McGarry', role: 'Sleep specialist, on a joint workshop on fatigue and sleep' },
  { quote: 'Georgia delivered an expert speaker session for The Governance Hub, and I would highly recommend her. The session was insightful, thought-provoking and full of practical takeaways that members could immediately apply within their own organisations.', name: 'Danni Kisielewicz', role: 'Former CQC Inspector, The Governance Hub' },
  { quote: 'Georgia presented the topic with clarity and expertise, making complex ideas both accessible and practical. She created an engaging and interactive environment that encouraged participation and reflection throughout the session.', name: 'Omonefe Davies', role: 'Academic, on Protecting Wellbeing for Early Career Researchers' },
  { quote: 'As an organisational psychologist, she’s highly ethical and evidence-led, making sure she’s providing the right solution for the problem in hand.', name: 'Leanne Elliott', role: 'Chartered Psychologist' },
  { quote: 'Georgia shows enthusiasm and dedication to everything she puts her mind to. She is a pleasure to work alongside and has upstanding values.', name: 'Karen Mills', role: 'Business Psychologist' },
  { quote: 'Georgia has quickly become indispensable. Since she joined the Truth, Lies & Work Podcast team as Associate Producer, she’s been the glue that holds all the chaos together.', name: 'Al Elliott', role: 'Co-host, Truth, Lies & Work podcast' },
];

const timeline = [
  { year: '2020', title: 'BSc Psychology', detail: 'A dissertation on sleep loss and decision-making that started the whole thing.' },
  { year: '2023', title: 'MSc Occupational Psychology', detail: 'Research into turnover in 24/7 operations and what exit interviews miss.' },
  { year: '2023', title: 'Human factors', detail: 'Human factors work across logistics, energy, emergency services and healthcare, focused on incident review and the design of shift work.' },
  { year: 'Jul 2024', title: "Georgia's PsyWork founded", detail: 'Independent practice working with shift workers and high-risk sectors across the UK, including logistics, utilities, energy, emergency services and healthcare.' },
  { year: 'Now', title: 'BPS Stage 2 chartership in Occupational Psychology', detail: "Supervised Level 8 qualification, with research on how leaders support people through AI-related change in small and medium-sized enterprises." },
];

const principles = [
  { stamp: '22:00', title: 'We go on shift', detail: 'We speak to people on nights, not just at head office in daylight hours.' },
  { stamp: '02:00', title: 'We look at the system', detail: 'Rotas, handovers, workload and tools first. Individual resilience last.' },
  { stamp: '04:00', title: 'We put a number on it', detail: 'Turnover, absence and risk, costed in terms your board already uses.' },
  { stamp: '06:00', title: 'We hand over properly', detail: 'Changes your team can run without us, and a clear way to tell if they worked.' },
];

const credentials = [
  { label: 'Graduate Member, British Psychological Society', value: 'GMBPsS' },
  { label: 'MSc Occupational Psychology', value: '2023' },
  { label: 'Fatigue risk management training', value: '2023' },
  { label: 'Chartership (in progress)', value: '2025–2027' },
  { label: 'Sectors', value: 'Logistics · Utilities · Energy · Emergency services · Healthcare' },
];
---

<BaseLayout title="About · Georgia's PsyWork">
  {/* Hero */}
  <Section gutter="reading" class="grid items-end gap-x-24 gap-y-14 md:grid-cols-2">
    <div class="flex flex-col gap-7">
      <Eyebrow>About · 06:00 handover</Eyebrow>
      <h1 class="text-display leading-display font-normal tracking-display text-balance">
        Most fatigue is designed into the work. So it can be <em>designed out.</em>
      </h1>
      <p class="max-w-[30em] text-lead leading-body text-muted text-pretty">
        Georgia's PsyWork is an organisational psychology practice for operations that never switch off. We work with the people who build rotas, run sites and answer for the incident log.
      </p>
    </div>
    <Photo src={speaking} alt="Georgia presenting at a lectern to a workshop audience, mid-sentence with a clipboard in one hand" ratio="4/5" loading="eager" class="max-w-[440px] justify-self-end object-[61%_50%]" />
  </Section>

  {/* Story */}
  <MarginSection tone="brand" label="Why this work" labelTone="amber">
    <Photo slot="aside" src={listening} alt="Georgia sitting on a chair at the side of a workshop room, smiling and listening" ratio="4/5" sizes="200px" class="max-w-[200px] object-[97%_50%]" />
    <p class="text-lead-xl leading-quote text-pretty text-white">I kept meeting capable people who were being blamed for mistakes the design of their work made almost inevitable.</p>
    <p class="text-2xl leading-loose text-pretty text-on-brand">Early in my career I spent a lot of time on night shifts, in depots and control rooms, listening to people describe the hours between two and five in the morning. The same story came up again and again. Good people, tired in predictable ways, at predictable points in the rota.</p>
    <p class="text-2xl leading-loose text-pretty text-on-brand">The fixes that organisations reached for were usually about the individual: a wellbeing app, a sleep leaflet, a reminder to take care. The causes were almost always in the design of the work. That gap is where this practice sits.</p>
    <p class="text-3xl italic text-white">Georgia Hodkinson GMBPsS</p>
  </MarginSection>

  {/* Experience */}
  <Section tone="deep" class="flex flex-col gap-12">
    <SectionHeader eyebrow="Experience" title="Nine years across three settings" tone="amber" />
    <StepGrid>
      <Step stamp="2 yrs" title="Recruitment" />
      <Step stamp="4 yrs" title="Healthcare" />
      <Step stamp="3 yrs" title="Occupational psychology" />
    </StepGrid>
  </Section>

  {/* Timeline */}
  <Section gutter="reading" class="flex flex-col gap-12">
    <SectionHeader eyebrow="Shift log" title="How we got here" />
    <RuledList>
      {
        timeline.map((item) => (
          <RuledRow lead={item.year} title={item.title} leadTone={item.year === 'Now' ? 'amber' : 'mint'}>
            {item.detail}
          </RuledRow>
        ))
      }
    </RuledList>
  </Section>

  {/* Principles */}
  <Section tone="deep" class="flex flex-col gap-14">
    <SectionHeader eyebrow="How we work" title="Four things we hold to" tone="amber" />
    <StepGrid>
      {
        principles.map((item) => (
          <Step stamp={item.stamp} title={item.title} variant="time">
            {item.detail}
          </Step>
        ))
      }
    </StepGrid>
  </Section>

  {/* Credentials */}
  <Section id="qualifications" gutter="reading" class="grid gap-x-24 gap-y-14 md:grid-cols-2">
    <div class="flex flex-col gap-4.5">
      <Eyebrow>Qualifications &amp; ethics</Eyebrow>
      <h2 class="text-title leading-title tracking-heading">Evidence-based, and accountable for it</h2>
      <p class="text-xl leading-prose text-pretty text-muted">All work follows the British Psychological Society Code of Ethics and Conduct. Findings are shared with the people who took part, not just the people who paid for them.</p>
      <Button href="#ethics" variant="underline" class="self-start">Read our ethics statement</Button>
    </div>
    <RuledList>
      {
        credentials.map((item) => (
          <div class="flex flex-wrap justify-between gap-6 py-5 text-lg">
            <span>{item.label}</span>
            <span class="text-mint">{item.value}</span>
          </div>
        ))
      }
    </RuledList>
  </Section>

  {/* Ethics and values */}
  <Section id="ethics" tone="deep" class="flex scroll-mt-12 flex-col gap-14">
    <SectionHeader eyebrow="Ethics & professional standards" title="What I value, and the standards I work to" tone="amber">
      <p class="text-xl leading-prose text-ink-soft text-pretty">
        As a Graduate Member of the British Psychological Society (BPS) and a member of the Association for Business Psychology (ABP), I work in line with their codes of conduct and recognised professional and ethical standards across occupational psychology and organisational practice. That means a commitment to evidence-based practice, confidentiality, professional integrity, and responsible approaches to workplace wellbeing, organisational change, and the use of AI within work systems.
      </p>
    </SectionHeader>
    <StepGrid class="lg:grid-cols-3 min-[1400px]:grid-cols-5 min-[1400px]:gap-x-8">
      <Step variant="number" stamp="01" title="Compassionate">Approach every client, organisation and context with both care and evidence.</Step>
      <Step variant="number" stamp="02" title="Honesty">Be transparent and accountable in all interactions.</Step>
      <Step variant="number" stamp="03" title="Curious growth">Keep a mindset of lifelong learning and continuous development.</Step>
      <Step variant="number" stamp="04" title="Respect">Acknowledge the unique stories, cultures and systems people operate within.</Step>
      <Step variant="number" stamp="05" title="Applied impact">Turn psychological theory into meaningful, actionable solutions.</Step>
    </StepGrid>
    <Button href="/services" variant="underline" class="self-start">Want to work with us?</Button>
  </Section>

  {/* Client feedback */}
  <Section id="client-feedback" tone="brand" gutter="reading" class="flex flex-col gap-12">
    <SectionHeader eyebrow="Client feedback" title="What clients say" tone="amber" />
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] gap-x-14 gap-y-12">
      <figure class="flex flex-col gap-4">
        <Eyebrow tone="amber">Logistics and HGV driver fatigue</Eyebrow>
        <blockquote class="text-2xl leading-loose text-pretty text-white italic">&ldquo;Georgia brought a thoughtful, evidence-based approach to understanding fatigue and human factors in our operational environment. She helped us look beyond driver behaviour and consider the working conditions that can influence decision-making and safety.&rdquo;</blockquote>
      </figure>
      <figure class="flex flex-col gap-4">
        <Eyebrow tone="amber">Energy sector and emergency call-out work</Eyebrow>
        <blockquote class="text-2xl leading-loose text-pretty text-white italic">&ldquo;Georgia demonstrated a strong understanding of the challenges facing teams working under operational pressure. Her ability to connect psychological research with the practical realities of emergency response and fatigue risk was particularly valuable.&rdquo;</blockquote>
      </figure>
      <figure class="flex flex-col gap-4">
        <Eyebrow tone="amber">Translating research into practical recommendations</Eyebrow>
        <blockquote class="text-2xl leading-loose text-pretty text-white italic">&ldquo;What stood out about working with Georgia was her ability to make complex human factors concepts understandable and relevant. She approached the project with curiosity, professionalism and a clear focus on recommendations that could work in practice.&rdquo;</blockquote>
      </figure>
      <figure class="flex flex-col gap-4">
        <Eyebrow tone="amber">A collaborative and insightful approach</Eyebrow>
        <blockquote class="text-2xl leading-loose text-pretty text-white italic">&ldquo;Georgia was engaging, thorough and genuinely interested in understanding how our people experienced their work. She asked thoughtful questions, challenged assumptions constructively and brought a valuable perspective to the project.&rdquo;</blockquote>
      </figure>
      <figure class="flex flex-col gap-4">
        <Eyebrow tone="amber">Co-creating ThinkClick</Eyebrow>
        <blockquote class="text-2xl leading-loose text-pretty text-white italic">&ldquo;Co-creating ThinkClick with Georgia has been one of the most important partnerships of my entrepreneurial journey. Georgia is talented and knowledgeable. She has this unique blend of creative intelligence, psychological understanding, and design thinking that turns complex ideas into experiences people feel, not just understand&hellip; I couldn&rsquo;t recommend her more highly.&rdquo;</blockquote>
        <figcaption class="text-base text-on-brand-muted">Tim Pattenden, Pattenden Peak Performance</figcaption>
      </figure>
      <figure class="flex flex-col gap-4">
        <Eyebrow tone="amber">Case-UK mental health coaching programme</Eyebrow>
        <blockquote class="text-2xl leading-loose text-pretty text-white italic">&ldquo;At Case-UK we co-created the now CPD accredited mental health coaching programme. Georgia is collaborative and enjoyable to work with. She partners with organisations really well, meeting deadlines, supporting with knowledge gaps and ultimately ensuring a high quality and impactful product is produced. I highly recommend working with Georgia.&rdquo;</blockquote>
        <figcaption class="text-base text-on-brand-muted">Tim Pattenden, Case-UK (part of The Busy Group)</figcaption>
      </figure>
    </div>
    <div class="flex flex-col gap-10 border-t border-brand-edge pt-12">
      <Eyebrow tone="amber">Recommendations from clients and collaborators</Eyebrow>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-x-12 gap-y-12">
        {recommendations.map((r) => (
          <figure class="flex flex-col gap-4">
            <blockquote class="text-xl leading-body text-pretty text-white italic">&ldquo;{r.quote}&rdquo;</blockquote>
            <figcaption class="flex flex-col gap-1">
              <span class="text-base text-white">{r.name}</span>
              <span class="text-sm text-on-brand-muted">{r.role}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </Section>
</BaseLayout>
