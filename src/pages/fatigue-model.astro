---
import BaseLayout from '../layouts/BaseLayout.astro';
import FatigueDrivers from '../components/FatigueDrivers.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="The 8-factor fatigue model · Georgia's PsyWork"
  description="Fatigue at work rarely has a single cause. The eight factors we assess, and what the research says about each."
>
  <FatigueDrivers
    heading="h1"
    eyebrow="Our approach"
    title="The 8-factor fatigue model"
    intro="Fatigue at work rarely has a single cause. We assess eight factors, from sleep and recovery to culture and management. Choose a factor to see what it covers and what the research says."
  />

  <Section gutter="reading" size="sm" class="flex flex-col items-start gap-6 pt-0">
    <p class="max-w-[34em] text-xl leading-prose text-pretty text-muted">Want to see how the eight factors show up in your operation?</p>
    <div class="flex flex-wrap gap-4">
      <Button href={site.calendly} variant="brand">Talk it through with Georgia</Button>
      <Button href="/services" variant="outline">See our services</Button>
    </div>
  </Section>
</BaseLayout>
