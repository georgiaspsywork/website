<BaseLayout title="Rota fatigue builder · Georgia's PsyWork">
{/* Resource header */}
<section class="flex flex-col gap-6.5 pb-section-sm pt-section-sm px-gutter-reading">
<div class="flex flex-wrap gap-2.5 text-sm text-subtle"><a class="text-mint" href="/resources">Resources</a><span>/</span><span>Tool</span></div>
<h1 class="max-w-[14em] font-normal text-display text-balance leading-display tracking-display">Most rotas pass compliance and still wear people down. Build a week and see where.</h1>
<p class="max-w-[32em] text-lead text-muted text-pretty leading-body">Click any shift to cycle Off, Early, Late, Night. We flag quick returns, long runs of nights and backward rotation as you go. This is a sketch of what a fatigue review looks at first.</p>
<div class="flex flex-wrap items-center gap-4 mt-1.5">
<a class="px-7 py-4 font-semibold text-lg text-ground bg-amber rounded-xs hover:text-ground hover:bg-amber-hover" href="#rota">Build a week</a>
<a class="px-6.5 py-4 text-lg border border-brand-edge rounded-xs" href="#">Send us your real rota</a>
</div>
</section>
{/* Facts */}
<section class="pb-section-sm pt-0 px-gutter-reading">
<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,180px),1fr))] border-b border-line border-t">
<div class="flex flex-col gap-1.5 pb-5.5 pl-0 pr-6 pt-5.5"><span class="text-2xs text-subtle tracking-label uppercase">Type</span><span class="text-xl">Tool</span></div>
<div class="flex flex-col gap-1.5 pb-5.5 pl-0 pr-6 pt-5.5"><span class="text-2xs text-subtle tracking-label uppercase">Time needed</span><span class="text-xl">5 minutes</span></div>
<div class="flex flex-col gap-1.5 pb-5.5 pl-0 pr-6 pt-5.5"><span class="text-2xs text-subtle tracking-label uppercase">Format</span><span class="text-xl">Interactive, in your browser</span></div>
<div class="flex flex-col gap-1.5 pb-5.5 pl-0 pr-6 pt-5.5"><span class="text-2xs text-subtle tracking-label uppercase">Best for</span><span class="text-xl">Rota planners and ops leaders</span></div>
</div>
</section>
