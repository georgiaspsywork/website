---
import { ALERT, barHeight, pad, phaseFor } from '../lib/alertness';

// 24-hour alertness bars. Click an hour to see what is typical then.
// Slots: "intro" (eyebrow + heading beside the big clock) and "cta" (button/line under the explanation).
interface Props {
  start?: number; // initial hour
}
const { start = 7 } = Astro.props;
const [phase, line] = phaseFor(start);
---

<section class="bg-deep text-warm" data-alertness>
  <div class="flex flex-wrap items-end gap-x-16 gap-y-6 px-gutter pt-section-sm">
    <p class="text-numeral leading-none font-normal tracking-numeral text-amber tabular-nums" data-label>{pad(start)}:00</p>
    <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-4.5 pb-2.5"><slot name="intro" /></div>
  </div>
  <div class="px-gutter pt-14">
    <div class="grid h-52.5 grid-cols-[repeat(24,minmax(0,1fr))] items-end gap-[clamp(2px,.5vw,6px)]">
      {
        ALERT.map((v, hour) => (
          <button
            type="button"
            aria-label={`${pad(hour)}:00`}
            data-hour={hour}
            data-now={hour === start ? '' : undefined}
            data-low={v < 0.3 ? '' : undefined}
            style={`height:${barHeight(v)}px`}
            class="cursor-pointer rounded-xs bg-night-bar hover:opacity-80 data-low:bg-shift-late data-now:bg-amber"
          />
        ))
      }
    </div>
    <div class="mt-2.5 grid grid-cols-[repeat(24,minmax(0,1fr))] gap-[clamp(2px,.5vw,6px)] text-2xs tabular-nums">
      {
        ALERT.map((_, hour) => (
          <span data-tick data-now={hour === start ? '' : undefined} class="text-center text-faint data-now:text-amber">
            {hour % 3 === 0 ? pad(hour) : ''}
          </span>
        ))
      }
    </div>
    <div class="mt-4 flex flex-wrap justify-between gap-x-6 gap-y-2 text-xs tracking-label text-faint uppercase">
      <span>Typical alertness across 24 hours · click any hour</span>
      <span>Illustrative curve, not measured data</span>
    </div>
  </div>
  <div class="grid gap-x-16 gap-y-6 px-gutter pt-12 pb-section md:grid-cols-[240px_minmax(0,1fr)]">
    <p class="text-2xl text-amber italic" data-phase>{phase}</p>
    <div class="flex flex-col gap-7">
      <p class="max-w-[30em] text-subtitle leading-lead text-pretty" data-line>{line}</p>
      <slot name="cta" />
    </div>
  </div>
</section>

<script>
  import { pad, phaseFor } from '../lib/alertness';

  document.querySelectorAll<HTMLElement>('[data-alertness]').forEach((root) => {
    const bars = root.querySelectorAll<HTMLElement>('[data-hour]');
    const ticks = root.querySelectorAll<HTMLElement>('[data-tick]');
    const label = root.querySelector('[data-label]')!;
    const phase = root.querySelector('[data-phase]')!;
    const line = root.querySelector('[data-line]')!;

    bars.forEach((bar) =>
      bar.addEventListener('click', () => {
        const hour = Number(bar.dataset.hour);
        const [title, text] = phaseFor(hour);
        bars.forEach((b, i) => b.toggleAttribute('data-now', i === hour));
        ticks.forEach((t, i) => t.toggleAttribute('data-now', i === hour));
        label.textContent = `${pad(hour)}:00`;
        phase.textContent = title;
        line.textContent = text;
      }),
    );
  });
</script>
