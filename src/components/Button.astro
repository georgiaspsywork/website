---
// Links styled as buttons. `variant` picks the look; use `primary` for the main action on dark ground.
interface Props {
  href: string;
  variant?: 'primary' | 'amber' | 'brand' | 'outline' | 'underline' | 'underline-white';
  class?: string;
  target?: string;
}
const { href, variant = 'primary', class: extra, target } = Astro.props;
const lift = 'transition duration-200 ease-out hover:-translate-y-0.5 hover:shadow-lg motion-reduce:transition-none motion-reduce:hover:translate-y-0';
const variants = {
  primary: lift + ' rounded-xs bg-mint px-6 py-3.5 text-md font-semibold text-ink-dark hover:bg-mint-hover hover:text-ink-dark',
  amber: lift + ' rounded-xs bg-amber px-7 py-4 text-lg font-semibold text-ground hover:bg-amber-hover hover:text-ground',
  brand: lift + ' rounded-xs bg-brand px-7 py-4 text-lg font-semibold whitespace-nowrap text-ink-bright hover:bg-brand-hover hover:text-ink-bright',
  outline: lift + ' rounded-xs border border-brand-edge px-6.5 py-4 text-lg hover:border-mint',
  underline: 'border-b border-mint text-lg text-mint transition-all duration-200 hover:pb-1 motion-reduce:transition-none',
  'underline-white': 'border-b border-white text-lg text-white transition-all duration-200 hover:pb-1 hover:text-white motion-reduce:transition-none',
};
---

<a
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener' : undefined}
  class:list={[variants[variant], extra]}><slot /></a
>
