---
import Section from './Section.astro';
import { references } from '../data/references';

// Interactive version of the "Rota red flags" checklist. Tick every question that is true of the rota; the count and the
// "next" notes update as you go. Wording is Georgia's, from her checklist. Nothing is stored or sent.
const QUESTIONS = [
  { q: 'Do people work more than three nights in a row?', why: 'Injury risk was about 36% higher by the fourth night in a block than on the first (Fischer et al., 2017).', next: 'look at shortening the longest blocks of nights.' },
  { q: 'Is there ever less than 11 hours between the end of one shift and the start of the next?', why: 'A trial that halved short daily rest periods (under 11 hours between shifts) led to a smaller rise in sickness absence days (Djupedal et al., 2025).', next: 'list every quick return in the four weeks and who it affects.' },
  { q: 'Do people come off nights straight into a day or evening shift?', why: 'In interviews with night-shift workers, recovery time after nights was often not built into rosters and ate into days off (Moore & Ballardie, 2024).', next: 'check what the first day after a run of nights actually looks like.' },
  { q: 'Does the pattern rotate backwards, for example late shifts into early shifts?', why: 'Our rota builder flags backward rotation.', next: 'check which direction each crew moves through the pattern, and ask the crews how it feels.' },
  { q: 'Does anyone work more than five days without a rest day, or very long weeks?', why: 'Working 55 hours or more a week was linked to an estimated 745,194 deaths from heart disease and stroke worldwide in 2016 (Pega et al., 2021).', next: 'count the longest run of working days and the longest week for each person, including overtime.' },
  { q: 'Are any shifts longer than 12 hours?', why: 'Injury risk was higher on shifts longer than 12 hours (relative risk 1.34) (Fischer et al., 2017). Working more than 12 hours a day was also linked to more safety incidents, though the certainty of that evidence was low (Matre et al., 2021).', next: 'note which roles and which times of day the long shifts fall on.' },
  { q: 'Do breaks come less often than every four hours, or last under 30 minutes?', why: 'Injury risk was highest when rest breaks came less often than every four hours or lasted under 30 minutes (Fischer et al., 2017).', next: 'check the breaks people actually take, not just the ones on paper.' },
  { q: 'Is overtime or shift-swapping frequent, or always the same people?', why: 'HSE says problems with overtime and shift-swapping may point to inadequate resourcing and staffing levels (HSE, n.d.).', next: 'list who picked up the extra shifts over the last month.' },
  { q: 'Do your most demanding or safety-critical tasks fall between 02:00 and 06:00?', why: 'In shift workers, accuracy at 03:00 fell most on the hardest version of a task (Galy et al., 2008). HSE says people tire more easily when work is machine-paced, complex or monotonous (HSE, n.d.).', next: 'map the highest-risk tasks against the clock, and move or double-check what you can.' },
  { q: 'Do handovers happen at the end of long shifts, or in a rush or a noisy room?', why: 'In critical care nurses, time stress and fatigue were linked to poorer handover quality, and standardised handover tools were named as a help (Abou Hashish et al., 2023).', next: 'watch one handover at the end of a shift.' },
  { q: 'Do people drive home after night shifts?', why: 'Night-shift workers reported driving home, some for over two hours, and traffic accidents or near misses (Moore & Ballardie, 2024).', next: 'ask people how they get home, and what happens on the drive.' },
  { q: 'Have the people who work this rota been asked how it affects them?', why: 'HSE recommends consulting employees on working hours and shift patterns (HSE, n.d.).', next: 'put the same questions to the people on every shift, not just those at head office.' },
];
const cited = ['abouHashish2023', 'djupedal2025', 'fischer2017', 'galy2008', 'hse', 'matre2021', 'moore2024', 'pega2021'];
const refs = cited.map((id) => references.find((r) => r.id === id)).filter((r) => r !== undefined);
---

<Section id="check" size="none" class="scroll-mt-12 pb-section">
  <div class="mx-auto flex max-w-[860px] flex-col gap-10" data-redflags>
    <div class="flex flex-col border-b border-line *:border-t *:border-line">
      {
        QUESTIONS.map((item, i) => (
          <label class="group flex cursor-pointer gap-5 py-5">
            <input type="checkbox" class="mt-1.5 size-5 flex-none cursor-pointer accent-amber" data-flag />
            <span class="flex flex-col gap-2">
              <span class="text-xl leading-snug font-semibold text-ink-bright">{i + 1}. {item.q}</span>
              <span class="text-md leading-body text-muted text-pretty">{item.why}</span>
              <span class="text-md leading-body text-subtle text-pretty"><em>Next:</em> {item.next}</span>
            </span>
          </label>
        ))
      }
    </div>

    <div class="flex flex-col gap-3 rounded-sm bg-brand p-7" aria-live="polite">
      <p class="text-xs tracking-label text-on-brand-muted uppercase">Your flags</p>
      <p class="text-4xl leading-heading text-white tabular-nums"><span data-count>0</span> of {QUESTIONS.length} ticked</p>
      <p class="text-lg leading-body text-on-brand text-pretty" data-result hidden>Three or more is a pattern worth looking at with the people who work it.</p>
      <p class="text-md text-on-brand-muted">This is the first ten minutes of a fatigue review, not the whole of one.</p>
    </div>

    <div class="flex flex-col gap-4">
      <h2 class="text-2xl">References</h2>
      <ol class="flex list-decimal flex-col gap-3 pl-6">
        {refs.map((ref) => <li class="text-sm leading-prose text-muted text-pretty [overflow-wrap:anywhere]" set:html={ref.html} />)}
      </ol>
    </div>
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLElement>('[data-redflags]').forEach((root) => {
    const boxes = root.querySelectorAll<HTMLInputElement>('[data-flag]');
    const count = root.querySelector('[data-count]')!;
    const result = root.querySelector<HTMLElement>('[data-result]')!;
    const update = () => {
      const n = Array.from(boxes).filter((b) => b.checked).length;
      count.textContent = String(n);
      result.hidden = n < 3;
    };
    boxes.forEach((b) => b.addEventListener('change', update));
    update();
  });
</script>
