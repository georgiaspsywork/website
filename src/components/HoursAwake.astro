---
import { awakeLine, clockAfter } from '../lib/alertness';

// Slider: how long someone has been awake, and what that is comparable to.
interface Props {
  start?: number; // initial hours awake
  wokeAt?: number; // hour of waking (24h clock)
}
const { start = 23, wokeAt = 7 } = Astro.props;
---

<section
  class="grid gap-x-12 gap-y-6 bg-(--sky,var(--color-ground)) px-gutter-reading py-section transition-colors duration-700 md:grid-cols-[200px_minmax(0,1fr)]"
  data-awake
  data-woke-at={wokeAt}
>
  <span class="pt-5 text-sm tracking-label text-(--sky-ink,var(--color-subtle)) uppercase transition-colors duration-700">Hours awake</span>
  <div class="flex flex-wrap items-center gap-x-14 gap-y-8 rounded-sm bg-brand p-[clamp(28px,4vw,48px)]">
    <div class="flex flex-none flex-col gap-3.5">
      <span class="text-gauge leading-none tracking-numeral text-ink-bright tabular-nums" data-value>{start}</span>
      <span class="text-base text-on-brand-muted">
        hours · woke at {String(wokeAt).padStart(2, '0')}:00, now <span data-clock>{clockAfter(wokeAt, start)}</span>
      </span>
    </div>
    <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-5.5">
      <div class="flex flex-col gap-1">
        <input type="range" min="8" max="24" step="1" value={start} aria-label="Hours awake" class="h-7 w-full accent-mint" data-input />
        <div class="relative h-9 text-2xs tracking-label text-on-brand-muted uppercase tabular-nums" aria-hidden="true">
          <span class="absolute left-[56%] flex -translate-x-1/2 flex-col text-center"><span>17 h</span><span>0.05%</span></span>
          <span class="absolute right-0 flex flex-col text-right"><span>24 h</span><span>0.10%</span></span>
        </div>
      </div>
      <p class="text-4xl leading-lead text-ink-bright text-pretty" data-line>{awakeLine(start)}</p>
      <p class="text-sm text-on-brand-muted">Dawson &amp; Reid (1997): 40 adults, hand&ndash;eye coordination task. Drag to a typical night-shift finish. <a class="border-b border-on-brand-muted" href="/sources">Sources</a></p>
    </div>
  </div>
</section>

<script>
  import { awakeLine, clockAfter } from '../lib/alertness';

  document.querySelectorAll<HTMLElement>('[data-awake]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-input]')!;
    const value = root.querySelector('[data-value]')!;
    const clock = root.querySelector('[data-clock]')!;
    const line = root.querySelector('[data-line]')!;
    const wokeAt = Number(root.dataset.wokeAt);

    // The section's background fades from white through grey to black as the hours go by.
    const theme = getComputedStyle(document.documentElement);
    const rgb = (token: string) => {
      let hex = theme.getPropertyValue(token).trim().replace('#', '');
      if (hex.length === 3) hex = [...hex].map((c) => c + c).join('');
      return [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16));
    };
    const mix = (from: number[], to: number[], amount: number) => from.map((v, i) => v + (to[i] - v) * amount);
    const day = rgb('--color-white');
    const night = rgb('--color-deep');
    const min = Number(input.min);
    const max = Number(input.max);
    const dark = `rgb(${rgb('--color-ink-dark').join(' ')})`;
    const light = `rgb(${rgb('--color-ink-bright').join(' ')})`;
    const paint = (hours: number) => {
      const t = (hours - min) / (max - min);
      const [r, g, b] = mix(day, night, t).map(Math.round);
      root.style.setProperty('--sky', `rgb(${r} ${g} ${b})`);
      root.style.setProperty('--sky-ink', t < 0.5 ? dark : light);
    };

    paint(Number(input.value));
    input.addEventListener('input', () => {
      const hours = Number(input.value);
      value.textContent = String(hours);
      clock.textContent = clockAfter(wokeAt, hours);
      line.textContent = awakeLine(hours);
      paint(hours);
    });
  });
</script>
