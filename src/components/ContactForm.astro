---
import { site } from '../data/site';
import Photo from './Photo.astro';
import badge from '../assets/images/georgia-badge-selfie.webp';
import RuledList from './RuledList.astro';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

// "Prefer to write?" band: contact details beside a photo of Georgia.
---

<Section tone="deep" class="md:px-0">
  <div class="mx-auto grid items-center gap-x-10 gap-y-14 md:w-4/5 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
    <div class="flex flex-col gap-5.5">
      <SectionHeader eyebrow="Prefer to write?" size="md" title="Send a message">
        <p class="max-w-[28em] text-lg leading-prose text-muted text-pretty">
          I reply to every message within two working days. If it's easier, call or email directly.
        </p>
      </SectionHeader>
      <RuledList class="mt-3">
        <div class="flex flex-wrap justify-between gap-5 py-4.5 text-lg">
          <span class="text-subtle">Email</span>
          <a class="text-mint" href="mailto:Georgia@georgiaspsywork.com">Georgia@georgiaspsywork.com</a>
        </div>
        <div class="flex flex-wrap justify-between gap-5 py-4.5 text-lg">
          <span class="text-subtle">Phone</span>
          <a href="tel:+447507627754">+44 7507 627754</a>
        </div>
        <div class="flex flex-wrap justify-between gap-5 py-4.5 text-lg">
          <span class="text-subtle">Based in</span>
          <span>Leicestershire, United Kingdom</span>
        </div>
        <div class="flex flex-wrap justify-between gap-5 py-4.5 text-lg">
          <span class="text-subtle">Working with</span>
          <span>Sites across the UK</span>
        </div>
      </RuledList>
    </div>

    <Photo
      src={badge}
      alt="Georgia smiling and holding up a conference name badge that reads 'Georgia' and 'Talk to me about everything'"
      ratio="4/5"
      sizes="(min-width: 768px) 30vw, 100vw"
      class="max-w-[380px] md:max-w-none"
    />
  </div>
</Section>
