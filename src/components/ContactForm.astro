---
import { site } from '../data/site';
import Button from './Button.astro';
import RuledList from './RuledList.astro';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

// "Prefer to write?" band: contact details beside an "Email me" button (opens the visitor's email app).
---

<Section tone="deep" gutter="reading">
  <div class="grid gap-x-24 gap-y-14 lg:grid-cols-2">
    <div class="flex flex-col gap-5.5">
      <SectionHeader eyebrow="Prefer to write?" size="md" title="Send a message">
        <p class="max-w-[28em] text-lg leading-prose text-muted text-pretty">
          We reply to every message within two working days. If it's easier, call or email directly.
        </p>
      </SectionHeader>
      <RuledList class="mt-3">
        <div class="flex flex-wrap justify-between gap-5 py-4.5 text-lg">
          <span class="text-subtle">Email</span>
          <a class="text-mint" href="mailto:Georgia@georgiaspsywork.com">Georgia@georgiaspsywork.com</a>
        </div>
        <div class="flex flex-wrap justify-between gap-5 py-4.5 text-lg">
          <span class="text-subtle">Phone</span>
          <a href="tel:+447507627754">+44 7507 627754</a>
        </div>
        <div class="flex flex-wrap justify-between gap-5 py-4.5 text-lg">
          <span class="text-subtle">Based in</span>
          <span>Leicestershire, United Kingdom</span>
        </div>
        <div class="flex flex-wrap justify-between gap-5 py-4.5 text-lg">
          <span class="text-subtle">Working with</span>
          <span>Sites across the UK</span>
        </div>
      </RuledList>
    </div>

    <div class="flex flex-col items-start justify-center gap-5.5">
      <Button href={`mailto:${site.email}`} variant="primary" class="text-lg">Email me</Button>
      <span class="text-sm text-faint">Opens your email app, addressed to {site.email}.</span>
    </div>
  </div>
</Section>
