---
// The site logo: leaf mark, "PsyWork" and a one-line descriptor. Links home.
import { site } from '../data/site';
---

<a href="/" class="flex items-center gap-2.5" aria-label={`${site.name}, home`}>
  <svg class="h-10 w-auto flex-none text-mint" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M8 33C6 16 17 6 33 5C34 22 25 34 8 33Z" />
    <path d="M8 33L24 15" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="text-3xl font-semibold tracking-heading">PsyWork</span>
    <span class="mt-1.5 text-3xs tracking-label whitespace-nowrap text-mint uppercase max-[23rem]:hidden">Organisational psychology</span>
  </span>
</a>
