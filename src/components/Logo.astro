---
// The site logo: circle-and-leaf mark (traced from Georgia's logo), "PsyWork" and a one-line descriptor. Links home.
import { Image } from 'astro:assets';
import mark from '../assets/images/logo-mark.webp';
import { site } from '../data/site';
---

<a href="/" class="flex items-center gap-2.5" aria-label={`${site.name}, home`}>
  <Image src={mark} alt="Georgia&rsquo;s PsyWork logo" width={160} height={160} class="size-10 flex-none" />


  <span class="flex flex-col leading-none">
    <span class="text-3xl font-semibold tracking-heading">PsyWork</span>
    <span class="mt-1.5 text-3xs tracking-label whitespace-nowrap text-mint uppercase max-[23rem]:hidden">Organisational psychology</span>
  </span>
</a>
