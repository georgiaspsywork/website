---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';

// Card in the resource library (and "use it alongside" lists). Multi-part resources get a stacked-card edge.
interface Props {
  resource: CollectionEntry<'resources'>;
  /** Library cards take part in the type filter. */
  filterable?: boolean;
}
const { resource, filterable = false } = Astro.props;
const { title, type, meta, summary, audience, action, parts, href } = resource.data;
const stacks = ['', 'mr-2 mb-2 shadow-stack-1', 'mr-4 mb-4 shadow-stack-2', 'mr-6 mb-6 shadow-stack-3'];
---

<a
  href={href ?? `/resources/${resource.id}`}
  data-filter-item={filterable ? '' : undefined}
  data-category={filterable ? type : undefined}
  class:list={[
    'flex min-h-75 flex-col gap-4 rounded-sm border border-line-soft bg-surface p-7 text-ink hover:border-mint hover:text-ink',
    stacks[parts],
  ]}
>
  <div class="flex justify-between gap-4 text-xs tracking-label uppercase">
    <span class="text-mint">{type}</span><span class="text-subtle">{meta}</span>
  </div>
  <h3 class="text-3xl leading-heading text-pretty">{title}</h3>
  <p class="text-md leading-body text-muted text-pretty">{summary}</p>
  <div class="mt-auto flex items-center justify-between gap-4 border-t border-line-soft pt-4 text-sm">
    <span class="text-subtle">For {audience}</span>
    <span class="text-amber">{action} <Arrow /></span>
  </div>
</a>
