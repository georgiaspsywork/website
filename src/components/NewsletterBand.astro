---
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';

// Contact-list sign-up band: a button that opens the Google Form in a new tab.
interface Props {
  eyebrow?: string;
  title?: string;
  href?: string;
  label?: string;
}
const { eyebrow, title = 'Join my contact list', href = 'https://forms.gle/6r8pWkmsPnrZMuj79', label = 'Join my contact list' } = Astro.props;
---

<section class="grid items-center gap-x-18 gap-y-8 bg-brand px-gutter-reading py-section-sm text-white md:grid-cols-2">
  <div class="flex flex-col gap-4">
    {eyebrow && <Eyebrow tone="amber">{eyebrow}</Eyebrow>}
    <h2 class="text-title leading-title tracking-heading">{title}</h2>
  </div>
  <div class="md:justify-self-end">
    <Button href={href} target="_blank" variant="amber">{label} ↗</Button>
  </div>
</section>
